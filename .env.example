# Hosted inference on main (keep credentials private).
INFERENCE_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
# Set INFERENCE_PROVIDER=ollama to use the local baseline.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# Hosted embeddings; local remains the code default without this setting.
EMBEDDING_PROVIDER=hosted
EMBEDDING_BASE_URL=https://api.dek.io.vn/v1/
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_API_KEY=
API_BASE_URL=http://127.0.0.1:8000
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
GRADIO_SERVER_NAME=127.0.0.1

# Optional password-protected public Gradio link; laptop must stay running.
GRADIO_SHARE=false
DEMO_USERNAME=
DEMO_PASSWORD=

# Enable only after supplying your Langfuse Cloud project keys.
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_CAPTURE_CONTENT=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Final context is fixed at five articles.

# Docker Qdrant: docker compose up -d (localhost:6333).
# Use index/qdrant here only for embedded storage or Colab indexing.
QDRANT_PATH=
# Native Python/indexing: set QDRANT_URL and QDRANT_API_KEY to your Cloud cluster.
QDRANT_URL=
QDRANT_API_KEY=
# Compose: set the same Cloud URL/key below (otherwise it uses local Qdrant).
QDRANT_CLOUD_URL=
QDRANT_CLOUD_API_KEY=

# Hosted TEI reranker; empty key reuses EMBEDDING_API_KEY.
RERANK_PROVIDER=hosted
RERANK_URL=https://api.dek.io.vn/rerank
RERANK_API_KEY=
